# String de conexão PostgreSQL do Neon (use a URL com sslmode=require)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Segredo criptográfico para assinar o cookie de sessão JWT (mínimo de 32 caracteres aleatórios)
AUTH_SECRET="gere-uma-chave-secreta-longa-e-aleatoria-com-mais-de-32-caracteres"

# E-mail da conta Mestre/Admin com acesso ao Escudo do Mestre e edição livre de fichas
ADMIN_EMAIL="netojoseluizferreira@gmail.com"
